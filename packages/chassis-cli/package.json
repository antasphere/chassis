{
  "name": "@antasphere/chassis-cli",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antasphere/chassis.git",
    "directory": "packages/chassis-cli"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "test",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@antasphere/chassis-contract": "workspace:*",
    "@antasphere/chassis-sdk": "workspace:*",
    "@antasphere/cli-core": "^0.5.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "vitest": "^3.2.0"
  }
}
