{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@antasphere/chassis-contract#test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  },
  "globalPassThroughEnv": ["HUB_WIRE_SNAPSHOT"]
}
